#!/usr/bin/env bash
#
# ipad-virtual-monitor — use an iPad as a second, extended display over USB-C.
#
# Entry point only: every subcommand lives in lib/ and is dispatched from here.
# Nothing in this file changes the system.

set -euo pipefail

# Resolve symlinks before looking for lib/: `ln -s .../bin/ivm ~/.local/bin/ivm`
# is the simplest way to put the command on the PATH, and the libraries live next
# to the real file, not next to the link.
IVM_SELF=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
IVM_ROOT=$(cd -- "$(dirname -- "$IVM_SELF")/.." && printf '%s' "$PWD")
IVM_LIB_DIR=$IVM_ROOT/lib

# How this command was invoked, made absolute but not resolved. A symlink in
# ~/.local/bin is more stable than the path inside a checkout, and this is what
# gets written into Sunshine's configuration, which runs with a bare PATH.
_ivm_invoked=${BASH_SOURCE[0]}
if [[ $_ivm_invoked != /* ]]; then
    _ivm_invoked=$PWD/$_ivm_invoked
fi
# Resolve `./` and `..` in the directory, but keep the last component as it is:
# a symlink is what the user typed, and it is the stable name to write down.
IVM_INVOKED=$(cd -- "$(dirname -- "$_ivm_invoked")" && printf '%s/%s' "$PWD" "$(basename -- "$_ivm_invoked")")
unset _ivm_invoked

if [[ ! -r $IVM_LIB_DIR/common.sh ]]; then
    printf 'ivm: cannot find the libraries in %s\n' "$IVM_LIB_DIR" >&2
    printf 'ivm: the whole repository is needed, not only bin/ivm\n' >&2
    exit 1
fi

# shellcheck source=/dev/null
for _module in common config platform usb network net hyprland sunshine display watch up status doctor deps completion; do
    . "$IVM_LIB_DIR/$_module.sh"
done
unset _module

usage() {
    cat <<EOF
ivm $IVM_VERSION — an iPad as a second, extended display over USB-C

Usage: ivm <command> [options]

Everyday
  up            Prepare the host: Sunshine, its hook, the supervisor
  status        One screen with the state of every layer
  doctor        Check every layer and say what is broken (--report for an issue)
  down          Remove the virtual output and stop the supervisor

Setup
  net           Report, set up or take down the USB network (asks before sudo)
  deps          Inspect the Apple USB stack, or build it from source
  display       Create, remove or inspect the virtual output
  watch         Remove the output when the stream ends

More
  completion    Print a completion script for bash, zsh or fish
  version       Print the version
  help [CMD]    This help, or the help of one command

Read-only: status, doctor, net status, display status, deps status.
Nothing runs as root; the commands that need it print what they would run.
EOF
}

# `ivm help <command>` delegates to the command's own --help, so the two can
# never disagree about a flag.
_ivm_help() {
    local topic=${1:-}
    case $topic in
        ''|-h|--help) usage; return "$IVM_EXIT_OK" ;;
        up)       ivm_up --help ;;
        down)     ivm_down --help ;;
        status)   ivm_status --help ;;
        net)      ivm_net --help ;;
        deps)     ivm_deps --help ;;
        doctor)   ivm_doctor --help ;;
        display)  ivm_display --help ;;
        watch)    ivm_watch --help ;;
        completion) ivm_completion --help ;;
        version)  printf 'Usage: ivm version\n\nPrints the version and exits.\n' ;;
        help)     usage ;;
        *)
            printf 'ivm: no help for unknown command: %s\n\n' "$topic" >&2
            usage >&2
            return "$IVM_EXIT_USAGE"
            ;;
    esac
}

main() {
    local command=${1:-help}
    if (($#)); then shift; fi

    # This tool never runs as root. It inspects and configures the user's session,
    # and running the compositor queries as root talks to the wrong sockets.
    if ((EUID == 0)); then
        printf 'ivm: do not run this as root; it works on your session, not on the system\n' >&2
        return "$IVM_EXIT_USAGE"
    fi

    case "$command" in
        up)       ivm_up "$@" ;;
        down)     ivm_down "$@" ;;
        status)   ivm_status "$@" ;;
        net)      ivm_net "$@" ;;
        deps)     ivm_deps "$@" ;;
        doctor)   ivm_doctor "$@" ;;
        display)  ivm_display "$@" ;;
        watch)    ivm_watch "$@" ;;
        completion) ivm_completion "$@" ;;
        version|--version|-v) printf 'ivm %s\n' "$IVM_VERSION" ;;
        help|--help|-h) _ivm_help "$@" ;;
        *)
            printf 'ivm: unknown command: %s\n\n' "$command" >&2
            usage >&2
            return "$IVM_EXIT_USAGE"
            ;;
    esac
}

main "$@"
