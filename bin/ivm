#!/usr/bin/env bash
#
# ipad-virtual-monitor — use an iPad as a second, extended display over USB-C.
#
# Entry point only: every subcommand lives in lib/ and is dispatched from here.
# Nothing in this file changes the system.

set -euo pipefail

IVM_VERSION='0.1.0-dev'

# Resolve symlinks before looking for lib/: `ln -s .../bin/ivm ~/.local/bin/ivm`
# is the simplest way to put the command on the PATH, and the libraries live next
# to the real file, not next to the link.
IVM_SELF=$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
IVM_ROOT=$(cd -- "$(dirname -- "$IVM_SELF")/.." && printf '%s' "$PWD")
IVM_LIB_DIR=$IVM_ROOT/lib

# How this command was invoked, made absolute but not resolved. A symlink in
# ~/.local/bin is more stable than the path inside a checkout, and this is what
# gets written into Sunshine's configuration, which runs with a bare PATH.
_ivm_invoked=${BASH_SOURCE[0]}
if [[ $_ivm_invoked != /* ]]; then
    _ivm_invoked=$PWD/$_ivm_invoked
fi
# Resolve `./` and `..` in the directory, but keep the last component as it is:
# a symlink is what the user typed, and it is the stable name to write down.
IVM_INVOKED=$(cd -- "$(dirname -- "$_ivm_invoked")" && printf '%s/%s' "$PWD" "$(basename -- "$_ivm_invoked")")
unset _ivm_invoked

if [[ ! -r $IVM_LIB_DIR/common.sh ]]; then
    printf 'ivm: cannot find the libraries in %s\n' "$IVM_LIB_DIR" >&2
    printf 'ivm: the whole repository is needed, not only bin/ivm\n' >&2
    exit 1
fi

# shellcheck source=/dev/null
for _module in common config platform usb network hyprland sunshine display watch up status doctor; do
    . "$IVM_LIB_DIR/$_module.sh"
done
unset _module

usage() {
    cat <<EOF
ivm $IVM_VERSION — turn an iPad into a second monitor over USB-C

Usage:
  ivm up                   Prepare the host: Sunshine, its hook, the supervisor
  ivm down [--all]         Remove the output and stop the supervisor
  ivm status               One-screen summary of the current state
  ivm doctor [--verbose]   Inspect every layer and report what is broken
  ivm display              Create, remove or inspect the virtual output
  ivm watch                Remove the output when the stream ends
  ivm version              Print the version
  ivm help                 Print this help

'ivm up' never asks for root: whatever needs it is reported with the command.
'ivm status', 'ivm doctor' and 'ivm display status' never change the system.
EOF
}

main() {
    local command=${1:-help}
    if (($#)); then shift; fi

    # This tool never runs as root. It inspects and configures the user's session,
    # and running the compositor queries as root talks to the wrong sockets.
    if ((EUID == 0)); then
        printf 'ivm: do not run this as root; it works on your session, not on the system\n' >&2
        return "$IVM_EXIT_USAGE"
    fi

    case "$command" in
        up)       ivm_up "$@" ;;
        down)     ivm_down "$@" ;;
        status)   ivm_status "$@" ;;
        doctor)   ivm_doctor "$@" ;;
        display)  ivm_display "$@" ;;
        watch)    ivm_watch "$@" ;;
        version|--version|-v) printf 'ivm %s\n' "$IVM_VERSION" ;;
        help|--help|-h) usage ;;
        *)
            printf 'ivm: unknown command: %s\n\n' "$command" >&2
            usage >&2
            return "$IVM_EXIT_USAGE"
            ;;
    esac
}

main "$@"
